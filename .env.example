# ------------------------------------------------------------------
# ApplyWise environment variables
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local       (macOS/Linux)
#   copy .env.example .env.local     (Windows)
# Never commit .env.local or any .env* file to git.
# ------------------------------------------------------------------

# Supabase project URL (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Google Gemini API key (server-side only; used by the resume analyzer
# and mock interview API routes. Never prefix it with NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key
